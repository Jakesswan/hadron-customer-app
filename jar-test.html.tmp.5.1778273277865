<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mnisi Jar-Test DSS — Decision Support System</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --bg: #07090f;
  --surface: #0d1220;
  --surface2: #131929;
  --surface3: #1a2235;
  --border: #1e2d45;
  --border2: #253349;
  --teal: #00e5c0;
  --teal2: #00b89c;
  --blue: #3d8bff;
  --amber: #ffb740;
  --red: #ff4d5e;
  --dark-red: #c0392b;
  --green: #00e5a0;
  --lt-green: #6bffcc;
  --text: #e8f0fe;
  --text2: #8fa3c0;
  --text3: #4a6080;
  --mono: 'Space Mono', monospace;
  --sans: 'Syne', sans-serif;
  --r: 6px;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 14px;
  min-height: 100vh;
  background-image:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0,229,192,0.06) 0%, transparent 60%),
    linear-gradient(180deg, #07090f 0%, #080c18 100%);
}

/* HEADER */
.hdr {
  background: rgba(13,18,32,0.95);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
  position: sticky; top:0; z-index:200;
  padding: 0 32px;
  height: 62px;
  display:flex; align-items:center; justify-content:space-between;
}
.hdr-brand { display:flex; align-items:center; gap:14px; }
.hdr-icon {
  width:36px; height:36px; border-radius:8px;
  background: linear-gradient(135deg, var(--teal), #009999);
  display:flex; align-items:center; justify-content:center;
  font-family:var(--mono); font-size:12px; font-weight:700; color:#000;
  letter-spacing:-0.5px;
}
.hdr-title { font-size:15px; font-weight:700; letter-spacing:0.02em; }
.hdr-sub { font-family:var(--mono); font-size:10px; color:var(--text3); letter-spacing:0.06em; }
.hdr-actions { display:flex; gap:10px; align-items:center; }

/* BUTTONS */
.btn {
  font-family:var(--mono); font-size:11px; font-weight:700;
  border:none; border-radius:var(--r);
  padding:9px 18px; cursor:pointer;
  letter-spacing:0.04em; transition:all .15s;
  display:inline-flex; align-items:center; gap:6px; white-space:nowrap;
}
.btn-primary { background:var(--teal); color:#000; }
.btn-primary:hover { background:var(--teal2); transform:translateY(-1px); box-shadow:0 4px 16px rgba(0,229,192,0.25); }
.btn-secondary { background:var(--surface2); border:1px solid var(--border2); color:var(--text2); }
.btn-secondary:hover { border-color:var(--teal); color:var(--teal); }
.btn-ghost { background:transparent; border:1px solid var(--border2); color:var(--text3); padding:6px 10px; font-size:10px; }
.btn-ghost:hover { border-color:var(--red); color:var(--red); }
.btn-blue { background:var(--blue); color:#fff; }
.btn-blue:hover { background:#2d7af0; }
.btn-run { background:var(--teal); color:#000; font-size:13px; padding:10px 24px; }
.btn-run:hover { background:var(--teal2); box-shadow:0 4px 20px rgba(0,229,192,0.3); }
.btn-sm { padding:5px 10px; font-size:10px; }
.btn-add { background:rgba(0,229,192,0.08); border:1px dashed rgba(0,229,192,0.3); color:var(--teal); }
.btn-add:hover { background:rgba(0,229,192,0.15); }

/* LAYOUT */
.wrap { max-width:1300px; margin:0 auto; padding:28px 32px 100px; }
.page-lbl {
  font-family:var(--mono); font-size:10px; color:var(--text3);
  letter-spacing:0.12em; text-transform:uppercase;
  margin-bottom:24px; padding-bottom:12px;
  border-bottom: 1px solid var(--border);
}

.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin-bottom:14px; }
.mb { margin-bottom:14px; }

/* CARDS */
.card {
  background:var(--surface); border:1px solid var(--border);
  border-radius:10px; overflow:hidden;
}
.card-hdr {
  padding:11px 16px;
  border-bottom:1px solid var(--border);
  background:var(--surface2);
  display:flex; align-items:center; justify-content:space-between;
}
.card-title {
  font-family:var(--mono); font-size:10px; font-weight:700;
  color:var(--text2); letter-spacing:0.1em; text-transform:uppercase;
  display:flex; align-items:center; gap:8px;
}
.dot { width:6px; height:6px; border-radius:50%; background:var(--teal); display:inline-block; flex-shrink:0; }
.dot-warn { background:var(--amber); }
.dot-blue { background:var(--blue); }
.dot-red  { background:var(--red); }
.card-body { padding:16px; }

/* FORM */
.fg { display:flex; flex-direction:column; gap:5px; margin-bottom:12px; }
.fg:last-child { margin-bottom:0; }
label { font-family:var(--mono); font-size:10px; color:var(--text3); letter-spacing:0.06em; text-transform:uppercase; }
.hint { font-family:var(--mono); font-size:10px; color:var(--text3); margin-top:3px; }
input[type=number], input[type=text] {
  background:var(--bg); border:1px solid var(--border2);
  border-radius:var(--r); color:var(--text);
  font-family:var(--mono); font-size:12px;
  padding:8px 10px; width:100%;
  transition:border-color .15s;
  -moz-appearance:textfield;
}
input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance:none; }
input:focus { outline:none; border-color:var(--teal); box-shadow:0 0 0 2px rgba(0,229,192,0.1); }
input::placeholder { color:var(--text3); }

/* TABLE */
.tbl-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-family:var(--mono); font-size:11px; }
thead th {
  background:var(--surface2); border-bottom:1px solid var(--border);
  padding:9px 10px; text-align:left;
  font-size:9px; color:var(--text3); letter-spacing:0.09em;
  text-transform:uppercase; font-weight:700; white-space:nowrap;
}
tbody tr { border-bottom:1px solid var(--border); transition:background .1s; }
tbody tr:hover { background:rgba(255,255,255,0.02); }
tbody tr:last-child { border-bottom:none; }
tbody td { padding:5px 6px; vertical-align:middle; }
tbody td input {
  border:1px solid transparent; background:transparent;
  padding:6px 8px; border-radius:4px; min-width:90px;
}
tbody td input:focus { background:var(--bg); border-color:var(--teal); }
.row-n { color:var(--text3); font-size:10px; text-align:center; min-width:24px; }

/* RESULTS */
#results { display:none; }

.best-banner {
  border-radius:10px; padding:22px 26px; margin-bottom:14px;
  border:1px solid; display:flex; align-items:flex-start; gap:24px;
  position:relative; overflow:hidden;
}
.best-banner::before {
  content:'';position:absolute;top:0;right:0;bottom:0;left:0;
  background:linear-gradient(135deg,currentColor 0%,transparent 60%);
  opacity:0.04; pointer-events:none;
}
.best-banner.optimal   { border-color:rgba(0,229,160,.4); background:rgba(0,229,160,.06); }
.best-banner.best-avail { border-color:rgba(255,183,64,.4); background:rgba(255,183,64,.06); }

.status-pill {
  font-family:var(--mono); font-size:10px; font-weight:700;
  padding:4px 10px; border-radius:4px; letter-spacing:0.08em;
  flex-shrink:0; margin-top:3px;
}
.pill-optimal   { background:rgba(0,229,160,.2); color:var(--green); }
.pill-acceptable{ background:rgba(107,255,204,.15); color:var(--lt-green); }
.pill-marginal  { background:rgba(255,183,64,.2); color:var(--amber); }
.pill-rejected  { background:rgba(255,77,94,.2); color:var(--red); }
.pill-infeasible{ background:rgba(192,57,43,.25); color:#ff8080; }
.pill-best-avail{ background:rgba(255,183,64,.2); color:var(--amber); }

.best-name { font-size:22px; font-weight:800; color:var(--text); margin-bottom:4px; }
.best-sub  { font-family:var(--mono); font-size:11px; color:var(--text3); }
.metrics   { display:flex; gap:22px; flex-wrap:wrap; margin-top:14px; }
.metric    { display:flex; flex-direction:column; gap:3px; }
.metric-lbl { font-family:var(--mono); font-size:9px; color:var(--text3); letter-spacing:0.08em; text-transform:uppercase; }
.metric-val { font-family:var(--mono); font-size:16px; font-weight:700; }
.c-green { color:var(--green); }
.c-lt-green { color:var(--lt-green); }
.c-amber { color:var(--amber); }
.c-red   { color:var(--red); }
.c-teal  { color:var(--teal); }
.c-blue  { color:var(--blue); }

/* RESULTS TABLE */
.sc-col { font-weight:700; }
.best-row { background:rgba(0,229,192,0.05) !important; }
.status-lbl { font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:0.04em; }
.st-optimal   { color:var(--green); }
.st-acceptable{ color:var(--lt-green); }
.st-marginal  { color:var(--amber); }
.st-rejected  { color:var(--red); }
.st-infeasible{ color:#ff8080; }

/* WHAT-IF */
.whatif-row { display:none; }
.whatif-row.open { display:table-row; }
.whatif-cell {
  background:rgba(61,139,255,0.06);
  border-left:2px solid var(--blue);
  padding:10px 14px !important;
  font-family:var(--mono); font-size:11px; color:var(--blue);
}

/* DIAGNOSTICS */
.diag-list { list-style:none; display:flex; flex-direction:column; gap:8px; }
.diag-item {
  background:var(--surface2); border:1px solid var(--border);
  border-left:3px solid var(--amber);
  border-radius:var(--r); padding:10px 14px;
  font-family:var(--mono); font-size:11px; color:var(--text2);
  line-height:1.6;
}
.diag-item .diag-code {
  font-size:9px; color:var(--amber); letter-spacing:0.08em;
  text-transform:uppercase; margin-bottom:4px;
}

/* CHARTS */
.chart-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px; }
.chart-box {
  background:var(--surface); border:1px solid var(--border);
  border-radius:10px; padding:18px 20px;
}
.chart-box canvas { width:100% !important; height:260px !important; }
.chart-lbl {
  font-family:var(--mono); font-size:10px; font-weight:700;
  color:var(--text2); text-transform:uppercase; letter-spacing:0.1em;
  margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--border);
}

/* ASSESSMENT */
.assess-section { margin-bottom:16px; }
.assess-title {
  font-family:var(--mono); font-size:10px; color:var(--teal);
  text-transform:uppercase; letter-spacing:0.1em;
  margin-bottom:8px; padding-bottom:6px; border-bottom:1px solid var(--border);
}
.assess-body {
  font-family:var(--mono); font-size:12px; color:var(--text2);
  line-height:1.8; white-space:pre-line;
}
.directive-box {
  background:linear-gradient(135deg, rgba(0,229,192,0.08), rgba(61,139,255,0.08));
  border:1px solid rgba(0,229,192,0.3); border-radius:8px; padding:16px 20px;
  font-family:var(--mono); font-size:12px; color:var(--text); line-height:1.8;
  margin-top:10px;
}
.directive-box.warn-directive {
  background:linear-gradient(135deg,rgba(255,183,64,0.08),rgba(255,77,94,0.06));
  border-color:rgba(255,183,64,0.35); color:var(--amber);
}
.directive-label {
  font-size:9px; letter-spacing:0.1em; text-transform:uppercase;
  margin-bottom:6px; opacity:0.7;
}

/* COST PANEL */
.cost-badge {
  font-family:var(--mono); font-size:10px; color:var(--text3);
  background:rgba(61,139,255,0.1); border:1px solid rgba(61,139,255,0.2);
  border-radius:4px; padding:2px 8px;
}
.toggle-row { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
.toggle-lbl { font-family:var(--mono); font-size:11px; color:var(--text2); }
.toggle {
  position:relative; width:40px; height:22px;
  display:inline-block;
}
.toggle input { opacity:0; width:0; height:0; }
.toggle-slider {
  position:absolute; cursor:pointer; top:0;left:0;right:0;bottom:0;
  background:var(--surface3); border-radius:11px; border:1px solid var(--border2);
  transition:.2s;
}
.toggle-slider:before {
  content:''; position:absolute; height:16px; width:16px;
  left:2px; bottom:2px; background:var(--text3);
  border-radius:50%; transition:.2s;
}
.toggle input:checked + .toggle-slider { background:rgba(0,229,192,0.2); border-color:var(--teal); }
.toggle input:checked + .toggle-slider:before { transform:translateX(18px); background:var(--teal); }

/* WARN BOX */
.warn-strip {
  background:rgba(255,183,64,0.08); border:1px solid rgba(255,183,64,0.3);
  border-radius:var(--r); padding:10px 14px;
  font-family:var(--mono); font-size:11px; color:var(--amber);
  margin-bottom:14px; display:none;
}
.warn-strip::before { content:"⚠  "; }

/* ACTION BAR */
.action-bar {
  display:flex; align-items:center; gap:10px; padding:12px 16px;
  border-top:1px solid var(--border); background:var(--surface2);
}

/* FOOTER */
.ftr {
  position:fixed; bottom:0; left:0; right:0;
  background:rgba(13,18,32,0.97); border-top:1px solid var(--border);
  backdrop-filter:blur(10px); padding:10px 32px;
  display:flex; align-items:center; justify-content:space-between;
  font-family:var(--mono); font-size:10px; color:var(--text3); z-index:100;
}
.ftr-brand { color:var(--teal); }

/* PRINT */
@media print {
  .hdr,.ftr,.btn,#entry-section,.hdr-actions{display:none!important}
  body{background:#fff;color:#000; font-size:11px;}
  .card{border:1px solid #ccc;background:#fff; page-break-inside:avoid;}
  .assess-body,.diag-item{color:#222}
  .print-report-header { display:block !important; }
  .print-report-footer { display:block !important; }
  /* Table fix: shrink to fit page, prevent status column cutoff */
  .tbl-wrap { overflow:visible !important; }
  table { width:100% !important; table-layout:fixed; font-size:9px !important; }
  thead th { font-size:8px !important; padding:5px 4px !important; white-space:normal !important; }
  tbody td { font-size:9px !important; padding:4px !important; word-break:break-word; }
  tbody td input { display:none; }
  /* Ensure status and what-if columns are not clipped */
  .status-lbl { font-size:8px !important; }
  .score-bar { display:none; }
  /* Hide what-if toggle buttons on print */
  .whatif-row { display:none !important; }
  /* Tab panels: show all on print */
  .tab-bar { display:none !important; }
  .tab-panel { display:block !important; padding:12px 16px; border-top:1px solid #eee; }
  .chart-row { display:none !important; }
  .best-banner { background:#f9f9f9 !important; border:1px solid #ccc !important; color:#000 !important; }
  .best-name,.metric-val,.metric-lbl { color:#000 !important; }
  .directive-box { background:#f9f9f9 !important; border:1px solid #ccc !important; color:#000 !important; }
  .directive-label { color:#444 !important; }
  .diag-item { background:#fff !important; border-left-color:#999 !important; }
  .diag-code { color:#555 !important; }
  .wrap { padding:0 !important; max-width:100% !important; }
}
.print-report-header {
  display:none;
  text-align:center;
  border-bottom:2px solid #000;
  padding-bottom:14px;
  margin-bottom:20px;
}
.print-report-header .prh-title {
  font-family:'Space Mono',monospace;
  font-size:20px; font-weight:700; letter-spacing:0.04em; color:#000;
}
.print-report-header .prh-sub {
  font-family:'Space Mono',monospace;
  font-size:11px; color:#555; margin-top:4px; letter-spacing:0.06em;
}
.print-report-header .prh-meta {
  font-family:'Space Mono',monospace;
  font-size:10px; color:#777; margin-top:8px;
}
.print-report-footer {
  display:none;
  text-align:center;
  border-top:1px solid #ccc;
  padding-top:12px;
  margin-top:24px;
  font-family:'Space Mono',monospace;
  font-size:10px; color:#888;
}

/* RESPONSIVE */
@media(max-width:900px){
  .grid-2,.grid-3,.chart-row{grid-template-columns:1fr}
  .hdr{padding:0 16px}
  .wrap{padding:16px 16px 90px}
}

/* SCORE BAR */
.score-bar { height:4px; background:var(--border2); border-radius:2px; margin-top:4px; overflow:hidden; }
.score-bar-fill { height:100%; border-radius:2px; transition:width .5s ease; }

/* SECTION BADGE */
.sec-badge {
  display:inline-flex; align-items:center; gap:6px;
  font-family:var(--mono); font-size:9px; color:var(--text3);
  background:var(--surface3); border:1px solid var(--border);
  border-radius:4px; padding:3px 8px; margin-bottom:10px;
  letter-spacing:0.06em; text-transform:uppercase;
}

/* TABS */
.tab-bar {
  display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:0;
}
.tab {
  font-family:var(--mono); font-size:11px; padding:10px 20px; cursor:pointer;
  color:var(--text3); border-bottom:2px solid transparent; transition:all .15s;
  background:transparent; border:none; letter-spacing:0.04em;
}
.tab.active { color:var(--teal); border-bottom-color:var(--teal); }
.tab-panel { display:none; padding:16px; }
.tab-panel.active { display:block; }

.no-results { font-family:var(--mono); font-size:12px; color:var(--text3); text-align:center; padding:20px; }
</style>
</head>
<body>

<!-- Embed-mode hook: hide the tool's own header/footer when displayed in
     an iframe inside the Hadron Group app, so the parent window provides
     the chrome. Triggered via ?embed=1 in the URL. -->
<script>
  if (location.search.indexOf('embed=1') !== -1) {
    document.documentElement.classList.add('hg-embedded');
  }
</script>
<style>
  .hg-embedded .hdr,
  .hg-embedded .ftr { display: none !important; }
  .hg-embedded body { padding-top: 0; }
  .hg-embedded .wrap { padding-top: 16px; padding-bottom: 32px; }
</style>

<header class="hdr">
  <div class="hdr-brand">
    <div class="hdr-icon">MJ</div>
    <div>
      <div class="hdr-title">Mnisi Jar-Test DSS</div>
      <div class="hdr-sub">Powered by Mnisi Technologies</div>
    </div>
  </div>
  <div class="hdr-actions">
    <button class="btn btn-secondary" onclick="resetAll()">↺ Reset</button>
    <button class="btn btn-run" onclick="runAnalysis()">▶ Run Analysis</button>
    <button class="btn btn-blue" id="pdf-btn" style="display:none" onclick="window.print()">⎙ Print Report</button>
  </div>
</header>

<div class="wrap">
  <div id="entry-section">
    <!-- ROW 1 -->
    <div class="grid-2">
      <!-- Raw Water -->
      <div class="card">
        <div class="card-hdr">
          <span class="card-title"><span class="dot"></span>Raw Water Conditions</span>
        </div>
        <div class="card-body">
          <div class="fg">
            <label>Organisation / Site Name <span style="color:var(--text3);font-size:9px;text-transform:none">(optional)</span></label>
            <input type="text" id="org-name" placeholder="e.g. Hartbeespoort WTW">
          </div>
          <div class="fg">
            <label>Turbidity (NTU)</label>
            <input type="number" id="raw-turb" placeholder="e.g. 45.0" min="0" step="0.1">
          </div>
          <div class="fg">
            <label>pH</label>
            <input type="number" id="raw-ph" placeholder="e.g. 7.4" min="0" max="14" step="0.01">
          </div>
          <div class="fg">
            <label>Temperature (°C)</label>
            <input type="number" id="raw-temp" placeholder="e.g. 22.5" min="0" step="0.1">
          </div>
        </div>
      </div>

      <!-- Constraints -->
      <div class="card">
        <div class="card-hdr">
          <span class="card-title"><span class="dot dot-warn"></span>Treatment Constraints</span>
        </div>
        <div class="card-body">
          <div class="fg">
            <label>Target Turbidity ≤ (NTU)</label>
            <input type="number" id="tgt-turb" value="1.0" min="0" step="0.1">
            <span class="hint">Final turbidity must be ≤ this value to comply</span>
          </div>
          <div class="fg">
            <label>pH Lower Bound</label>
            <input type="number" id="ph-min" value="6.5" min="0" max="14" step="0.01">
          </div>
          <div class="fg">
            <label>pH Upper Bound</label>
            <input type="number" id="ph-max" value="8.5" min="0" max="14" step="0.01">
          </div>
        </div>
      </div>
    </div>

    <!-- Cost Panel -->
    <div class="card mb">
      <div class="card-hdr">
        <span class="card-title"><span class="dot dot-blue"></span>Cost-Adjusted Scoring <span style="font-size:9px;color:var(--text3);margin-left:6px;letter-spacing:0;text-transform:none;font-weight:400">(optional)</span></span>
        <label class="toggle"><input type="checkbox" id="cost-toggle" onchange="toggleCost()"><span class="toggle-slider"></span></label>
      </div>
      <div id="cost-panel" style="display:none">
        <div class="card-body">
          <div class="grid-2" style="margin-bottom:0">
            <div class="fg" style="margin-bottom:0">
              <label>Coagulant Cost (ZAR/kg)</label>
              <input type="number" id="coag-cost" placeholder="e.g. 8.50" min="0" step="0.01">
